---
import BaseLayout from '../layouts/base.astro';
---

<BaseLayout>
  <div class="intro-ca" aria-hidden="true"></div>
  <div class="scene">

    <video class="bg-video" playsinline autoplay loop muted preload="auto">
      <source src="/assets/img/background.mp4" type="video/mp4" />
    </video>

    <div class="overlay" aria-hidden="true"></div>

    <main class="content">
      <p class="greeting" aria-hidden="true">Hi, I'm</p>

      <h1 class="name" data-text="xensik_">xensik.</h1>

      <p class="subtitle">building software, breaking binaries</p>

      <nav class="links" aria-label="Social links">
        <a href="https://twitter.com/xensik" class="link-btn" aria-label="Twitter">
