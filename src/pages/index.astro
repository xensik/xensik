        </a>
        <a href="https://discord.com/users/248115862567911424/" class="link-btn" aria-label="Discord">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" aria-hidden="true"><path d="M524.531 69.836a1.5 1.5 0 0 0-.764-.7A485.065 485.065 0 0 0 404.081 32.03a1.816 1.816 0 0 0-1.923.91 337.461 337.461 0 0 0-14.9 30.6 447.848 447.848 0 0 0-134.426 0 309.541 309.541 0 0 0-15.135-30.6 1.89 1.89 0 0 0-1.924-.91A483.689 483.689 0 0 0 116.085 69.137a1.712 1.712 0 0 0-.788.676C39.068 183.651 18.186 294.69 28.43 404.354a2.016 2.016 0 0 0 .765 1.375A487.666 487.666 0 0 0 176.02 479.918a1.9 1.9 0 0 0 2.063-.676A348.2 348.2 0 0 0 208.12 430.4a1.86 1.86 0 0 0-1.019-2.588 321.173 321.173 0 0 1-45.868-21.853 1.885 1.885 0 0 1-.185-3.126c3.082-2.309 6.166-4.711 9.109-7.137a1.819 1.819 0 0 1 1.9-.256c96.229 43.917 200.41 43.917 295.5 0a1.812 1.812 0 0 1 1.924.233c2.944 2.426 6.027 4.851 9.132 7.16a1.884 1.884 0 0 1-.162 3.126 301.407 301.407 0 0 1-45.89 21.83 1.875 1.875 0 0 0-1 2.611 391.055 391.055 0 0 0 30.014 48.815 1.864 1.864 0 0 0 2.063.7A486.048 486.048 0 0 0 610.7 405.729a1.882 1.882 0 0 0 .765-1.352C623.729 277.594 590.933 167.465 524.531 69.836zM222.491 337.58c-28.972 0-52.844-26.587-52.844-59.239S193.056 219.1 222.491 219.1c29.665 0 53.306 26.82 52.843 59.239C275.334 310.993 251.924 337.58 222.491 337.58zm195.38 0c-28.971 0-52.843-26.587-52.843-59.239S388.437 219.1 417.871 219.1c29.667 0 53.307 26.82 52.844 59.239C470.715 310.993 447.538 337.58 417.871 337.58z"/></svg>
        </a>
        <a href="https://github.com/xensik" class="link-btn" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512" aria-hidden="true"><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 389.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z"/></svg>
        </a>
        <a href="mailto:xensik@pm.me" class="link-btn" aria-label="Email">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"/></svg>
        </a>
      </nav>
    </main>

    <footer class="foot">
      Copyright &copy; {new Date().getFullYear()}. All Rights Reserved.
    </footer>
  </div>

  <script>
    const video = document.querySelector('.bg-video') as HTMLVideoElement;
    if (video) {
      video.muted = true;
      video.play().catch(() => {
        document.addEventListener('click', () => video.play(), { once: true });
        document.addEventListener('touchstart', () => video.play(), { once: true });
      });
    }
  </script>
</BaseLayout>

<style>
  /* -- Layout ----------------------------------------- */
  .scene {
    position: fixed;
    inset: 0;
    animation: scene-reveal 0.5s 0.5s both ease-out;
  }

  @keyframes scene-reveal {
    0%   { opacity: 0; }
    80%  { opacity: 1; }
    90%  { opacity: 0.1;  }
    93%  { opacity: 0.9;  }
    95%  { opacity: 0.3;  }
    100% { opacity: 1;}
  }

  /* -- Intro CA glitch overlay ────────────────────── */
  .intro-ca {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    /* subtle scanlines visible during black phase */
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.018) 0px,
        rgba(255,255,255,0.018) 1px,
        transparent 1px,
        transparent 4px
      ),
      #000;
    animation: ca-overlay 2s ease-out forwards;
  }

  .intro-ca::before,
  .intro-ca::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    clip-path: polygon(0 0, 0 0, 0 0, 0 0);
  }

  /* red channel */
  .intro-ca::before {
    background: rgba(191, 0, 255, 0.75);
    mix-blend-mode: screen;
    animation: ca-red 2s linear forwards;
  }

  /* cyan channel */
  .intro-ca::after {
    background: rgba(12, 85, 28, 0.35);
    mix-blend-mode: screen;
    animation: ca-cyan 3s linear forwards;
  }

  @keyframes ca-overlay {
    0%    { opacity: 1;    transform: none; }
    14%   { opacity: 1;    transform: none; }
    15%   { opacity: 0.97; transform: translate(-3px,  1px) skewX(-0.3deg); }
    18%   { opacity: 0.95; transform: translate( 4px, -1px); }
    22%   { opacity: 0.92; transform: none; }
    34%   { opacity: 0.9;  transform: none; }
    35%   { opacity: 0.88; transform: translate( 2px,  2px); }
    40%   { opacity: 0.85; transform: translate(-3px,  0px) skewX(0.4deg); }
    42%   { opacity: 0.8;  transform: none; }
    59%   { opacity: 0.55; transform: none; }
    60%   { opacity: 0.5;  transform: translate(2px, 0); }
    61%   { opacity: 0.45; transform: none; }
    75%   { opacity: 0.15; }
    90%   { opacity: 0.03; }
    100%  { opacity: 0; }
  }

  @keyframes ca-red {
    0%, 14%  { opacity: 0; transform: translateX(0);    clip-path: polygon(0 0,0 0,0 0,0 0); }
    /* burst 1 */
    15%  { opacity: 0; }
    15.5%{ opacity: 1;   transform: translateX( 8px); clip-path: polygon(0   0%, 100%   0%, 100% 42%, 0 42%); }
    20%  { opacity: 0.7; transform: translateX( 6px); clip-path: polygon(0   0%, 100%   0%, 100% 42%, 0 42%); }
    21%  { opacity: 0;   transform: translateX( 0);   clip-path: polygon(0 0,0 0,0 0,0 0); }
    /* burst 2 */
    34%  { opacity: 0; transform: translateX(0); clip-path: polygon(0 0,0 0,0 0,0 0); }
    35%  { opacity: 0.9; transform: translateX(10px); clip-path: polygon(0 55%, 100% 55%, 100% 85%, 0 85%); }
    38%  { opacity: 0.6; transform: translateX( 7px); clip-path: polygon(0 55%, 100% 55%, 100% 85%, 0 85%); }
    39%  { opacity: 0.8; transform: translateX( 9px); clip-path: polygon(0 10%, 100% 10%, 100% 30%, 0 30%); }
    42%  { opacity: 0;   transform: translateX( 0);   clip-path: polygon(0 0,0 0,0 0,0 0); }
    /* settling flicker */
    59%  { opacity: 0; transform: translateX(0); clip-path: polygon(0 0,0 0,0 0,0 0); }
    60%  { opacity: 0.35; transform: translateX(5px); clip-path: polygon(0 30%, 100% 30%, 100% 62%, 0 62%); }
    61%  { opacity: 0;    transform: translateX(0);   clip-path: polygon(0 0,0 0,0 0,0 0); }
    100% { opacity: 0; }
  }

  @keyframes ca-cyan {
    0%, 14%  { opacity: 0; transform: translateX(0);    clip-path: polygon(0 0,0 0,0 0,0 0); }
    /* burst 1 */
    15%  { opacity: 0; }
    15.5%{ opacity: 1;   transform: translateX( -8px); clip-path: polygon(0 40%, 100% 40%, 100% 100%, 0 100%); }
    20%  { opacity: 0.7; transform: translateX( -6px); clip-path: polygon(0 40%, 100% 40%, 100% 100%, 0 100%); }
    21%  { opacity: 0;   transform: translateX(   0);  clip-path: polygon(0 0,0 0,0 0,0 0); }
    /* burst 2 */
    34%  { opacity: 0; transform: translateX(0); clip-path: polygon(0 0,0 0,0 0,0 0); }
    35%  { opacity: 0.9; transform: translateX(-10px); clip-path: polygon(0  0%, 100%  0%, 100% 40%, 0 40%); }
    38%  { opacity: 0.6; transform: translateX( -7px); clip-path: polygon(0  0%, 100%  0%, 100% 40%, 0 40%); }
    39%  { opacity: 0.8; transform: translateX( -9px); clip-path: polygon(0 65%, 100% 65%, 100% 90%, 0 90%); }
    42%  { opacity: 0;   transform: translateX(   0);  clip-path: polygon(0 0,0 0,0 0,0 0); }
    /* settling flicker */
    59%  { opacity: 0; transform: translateX(0); clip-path: polygon(0 0,0 0,0 0,0 0); }
    60%  { opacity: 0.35; transform: translateX(-5px); clip-path: polygon(0 30%, 100% 30%, 100% 62%, 0 62%); }
    61%  { opacity: 0;    transform: translateX(  0);  clip-path: polygon(0 0,0 0,0 0,0 0); }
    100% { opacity: 0; }
  }

  /* object-fit: cover achieves the requested behavior:
     portrait/square -> 100% height, clips sides (centre shown)
     ultra-wide      -> 100% width, clips top/bottom           */
  .bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: hue-rotate(300deg) contrast(1.5) brightness(0.5) grayscale(0.35);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.72) 100%);
    pointer-events: none;
  }

  .content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    user-select: none;
  }

  /* -- Typography ------------------------------------- */
  .greeting {
    font-size: 01rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.5em;
  }

  .name {
    position: relative;
    font-size: clamp(3.5rem, 20vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
    animation: glitch-trigger 4s 1s infinite steps(1);
  }

  .name::before,
  .name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    font: inherit;
    color: #fff;
    pointer-events: none;
    clip-path: polygon(0 0, 0 0, 0 0, 0 0);
  }

  .subtitle {
    padding-top: 10px;
    font-size: 1rem;
    letter-spacing: 0.03em;
    color: rgba(255,255,255,0.6);
    line-height: 1.75;
    margin-top: 0.75em;
  }

  /* -- Social links ----------------------------------- */
  .links {
    margin-top: 2.25rem;
    display: flex;
    gap: 1.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .link-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.4s ease;
    padding: 0.2rem 0;
  }

  .link-btn::after {
    content: '';
    display: block;
    height: 1px;
    width: 0.65rem;
    background: currentColor;
    transition: width 0.4s ease;
  }

  .link-btn:hover {
    color: rgba(255,255,255,0.9);
  }

  .link-btn:hover::after {
    width: 3rem;
  }

  .link-btn svg {
    width: 2.05rem;
    height: 2.05rem;
    fill: currentColor;
    pointer-events: none;
  }

  /* -- Footer ----------------------------------------- */
  .foot {
    position: absolute;
    bottom: 1.5rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    user-select: none;
  }

  /* -- Glitch ----------------------------------------- */

  /*
   * Split-slice glitch: base text goes invisible so only the two
   * complementary halves show — top moves right, bottom moves left.
   * All three animations share a 6s cycle so they fire in lockstep.
   */
  @keyframes glitch-trigger {
    /* idle */
    0%, 92%, 100% { color: #fff;         transform: translate(0); }
    /* hide base text — pseudo halves take over */
    92.9% { color: transparent; transform: translate(  0,   0); }
    93%   { color: transparent; transform: translate( 14px, 0); }
    93.5% { color: transparent; transform: translate(-10px, 0); }
    94%   { color: transparent; transform: translate( 12px, 0); }
    94.5% { color: transparent; transform: translate( -6px, 0); }
    95%   { color: transparent; transform: translate(  8px, 0); }
    95.5% { color: transparent; transform: translate(-11px, 0); }
    96%   { color: transparent; transform: translate(  6px, 0); }
    96.5% { color: transparent; transform: translate(  0,   0); }
    /* restore */
    97%   { color: #fff;         transform: translate(  0,   0); }
  }

  .name::before { animation: glitch-slice-a 4s 1s infinite steps(1); }
  .name::after  { animation: glitch-slice-b 4s 1s infinite steps(1); }

  /* top half — moves RIGHT */
  @keyframes glitch-slice-a {
    0%, 92%, 100% { clip-path: polygon(0 0,0 0,0 0,0 0); transform: translate(0);        color: #fff; }
    92.9% { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate(  0,    0); color: #fff; }
    93%   { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate( 14px,  0); color: #c678ff; }
    93.5% { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate(-10px,  0); color: #fff; }
    94%   { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate( 12px,  0); color: #bf00ff; }
    94.5% { clip-path: polygon(0 8%,100% 8%,100% 50%,0 50%);  transform: translate( -6px,  0); color: #fff; }
    95%   { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate(  8px,  0); color: #c678ff; }
    95.5% { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate(-11px,  0); color: #fff; }
    96%   { clip-path: polygon(0 0%,100% 0%,100% 46%,0 46%); transform: translate(  6px,  0); color: #fff; }
    96.5% { clip-path: polygon(0 0,0 0,0 0,0 0);              transform: translate(  0,    0); color: #fff; }
  }

  /* bottom half — moves LEFT (mirror of top) */
  @keyframes glitch-slice-b {
    0%, 92%, 100% { clip-path: polygon(0 0,0 0,0 0,0 0); transform: translate(0);        color: #fff; }
    92.9% { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate(    0, 0); color: #fff; }
    93%   { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate( -14px, 0); color: #fff; }
    93.5% { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate(  10px, 0); color: #bf00ff; }
    94%   { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate( -12px, 0); color: #fff; }
    94.5% { clip-path: polygon(0 44%,100% 44%,100% 92%,0 92%);   transform: translate(   6px, 0); color: #c678ff; }
    95%   { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate(  -8px, 0); color: #fff; }
    95.5% { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate(  11px, 0); color: #bf00ff; }
    96%   { clip-path: polygon(0 46%,100% 46%,100% 100%,0 100%); transform: translate(  -6px, 0); color: #fff; }
    96.5% { clip-path: polygon(0 0,0 0,0 0,0 0);                 transform: translate(    0, 0); color: #fff; }
  }

  /* -- Responsive ------------------------------------- */
  @media (max-width: 640px) {
    .links    { gap: 0.5rem; }
    .links    { gap: 1.25rem; }
    .link-btn svg { width: 2rem; height: 2rem; }
  }
</style>
